# ================================================
# COMPAREX – .gitignore
# Node.js + Python + Docker + IDE
# ================================================

# ── Node.js / Next.js ──────────────────────────
node_modules/
.next/
.nuxt/
dist/
build/
out/
*.tsbuildinfo
next-env.d.ts

# ── npm / yarn / pnpm ─────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json~

# ── Environment Files ──────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging

# ── Python ─────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
.venv/
venv/
ENV/
env/
.env/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# ── Testing ────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.hypothesis/
*.cover
coverage.xml
nosetests.xml
test-results/

# ── Alembic ────────────────────────────────────

# ── IDEs / Editors ─────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
*.iml
*.sublime-project
*.sublime-workspace

# ── Docker ─────────────────────────────────────
docker-compose.override.yml

# ── Logs ───────────────────────────────────────
logs/
*.log

# ── OS ─────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# ── Misc ───────────────────────────────────────
.cache/
.temp/
*.tmp
*.bak
